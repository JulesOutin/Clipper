# Clipper — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# --- Deepgram (transcription) ---
# Créer une clé sur https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Anthropic (sélection des clips et titres) ---
# Créer une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- YouTube Data v3 (publication) ---
# Configurer via OAuth — voir README.md section "Configuration OAuth YouTube"
# Ces valeurs sont générées automatiquement par clipper lors de la première auth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_PATH=data/youtube_token.json
